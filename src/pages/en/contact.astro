---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';

const departmentsEn = [
  { title: 'New Inquiries & Sales', email: 'ventas@kloudxp.com', desc: 'Commercial advisory, capacity planning, and customized proposals.' },
  { title: '24/7 Technical Support', email: 'soporte@kloudxp.com', desc: 'Operational incident resolution and telemetry monitoring.' },
  { title: 'General Administration', email: 'contacto@kloudxp.com', desc: 'Corporate communication and strategic alliances.' },
  { title: 'Careers & Talent', email: 'carreras@kloudxp.com', desc: 'Join our cloud infrastructure and DevOps engineering team.' }
];
---

<Layout
  title="Contact Us | KloudXP"
  description="Get in touch with KloudXP engineers. Direct phone +52-33-2233-4400, department emails, and corporate office in Zapopan, Jalisco."
  lang="en"
>
  <section class="py-20 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-mono uppercase tracking-widest text-sky-400 bg-sky-950/60 px-3.5 py-1 rounded-full border border-sky-800/60">
        Direct Communication
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Need a Trusted Technology Partner? Let's Talk.
      </h1>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto">
        Ready to answer your architectural questions, migration planning, or 24/7 infrastructure support needs.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-7 space-y-6">
        <div>
          <h2 class="text-2xl font-bold text-white">Send Us a Message</h2>
          <p class="text-slate-400 text-sm mt-1">
            Complete the form below and a solutions engineer will be in touch within 24 hours.
          </p>
        </div>
        <ContactForm lang="en" type="contact" />
      </div>

      <div class="lg:col-span-5 space-y-8">
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6 shadow-xl">
          <h3 class="text-lg font-bold text-white border-b border-slate-800 pb-3">Direct Contact & Offices</h3>
          <div class="space-y-5 text-sm">
            <!-- Mexico Phone -->
            <div class="flex items-start space-x-3">
              <div class="w-10 h-10 rounded-xl bg-sky-950/80 border border-sky-800/60 flex items-center justify-center text-sky-400 shrink-0">
                <span class="text-base">🇲🇽</span>
              </div>
              <div>
                <div class="text-xs text-slate-400 font-medium">Mexico Direct Line (Guadalajara)</div>
                <a href="tel:+523322334400" class="text-base font-bold text-white hover:text-sky-400 transition-colors font-mono">+52-33-2233-4400</a>
                <div class="text-[11px] text-slate-500">Mon - Fri 9:00 - 18:00 CST (24/7 Critical Support)</div>
              </div>
            </div>

            <!-- Colombia Phone -->
            <div class="flex items-start space-x-3">
              <div class="w-10 h-10 rounded-xl bg-cyan-950/80 border border-cyan-800/60 flex items-center justify-center text-cyan-400 shrink-0">
                <span class="text-base">🇨🇴</span>
              </div>
              <div>
                <div class="text-xs text-slate-400 font-medium">Colombia Direct Line (Bogota)</div>
                <a href="tel:+573134716622" class="text-base font-bold text-white hover:text-cyan-400 transition-colors font-mono">+57-3134716622</a>
                <div class="text-[11px] text-slate-500">Local engineering and sales support in Colombia</div>
              </div>
            </div>

            <!-- Corporate Email -->
            <div class="flex items-start space-x-3">
              <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-300 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs text-slate-400 font-medium">Corporate Email</div>
                <a href="mailto:contacto@kloudxp.com" class="text-base font-bold text-white hover:text-sky-400 transition-colors">contacto@kloudxp.com</a>
              </div>
            </div>

            <!-- Mexico Office -->
            <div class="pt-4 border-t border-slate-800/80 flex items-start space-x-3">
              <div class="w-10 h-10 rounded-xl bg-sky-950/50 border border-sky-900/50 flex items-center justify-center text-sky-400 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
              </div>
              <div>
                <div class="text-xs font-semibold text-white">Mexico Headquarters</div>
                <p class="text-slate-300 text-xs mt-0.5 leading-relaxed">Av. de las Américas 320, Altamira, 45160 Zapopan, Jalisco, Mexico</p>
                <a href="https://maps.app.goo.gl/gw5AMAMp1Nse4J8M7" target="_blank" rel="noopener noreferrer" class="text-xs text-sky-400 hover:text-sky-300 font-semibold inline-flex items-center mt-1">
                  Open in Google Maps ↗
                </a>
              </div>
            </div>

            <!-- Colombia Office -->
            <div class="pt-4 border-t border-slate-800/80 flex items-start space-x-3">
              <div class="w-10 h-10 rounded-xl bg-cyan-950/50 border border-cyan-900/50 flex items-center justify-center text-cyan-400 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs font-semibold text-white">Colombia Regional Operations</div>
                <p class="text-slate-300 text-xs mt-0.5 leading-relaxed">Local presence & operations in Bogota D.C., Colombia</p>
                <div class="text-[11px] text-cyan-400 font-medium mt-1">Andean region & South American coverage</div>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <h3 class="text-xs font-mono uppercase tracking-wider text-slate-400">Department Emails</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {departmentsEn.map((d) => (
              <div class="p-3.5 bg-slate-900/60 border border-slate-800 rounded-xl space-y-1">
                <div class="text-xs font-bold text-white">{d.title}</div>
                <a href={`mailto:${d.email}`} class="text-xs text-sky-400 hover:text-sky-300 font-mono block">{d.email}</a>
                <div class="text-[10px] text-slate-500">{d.desc}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
