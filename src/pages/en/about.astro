---
import Layout from '../../layouts/Layout.astro';
import ClientLogos from '../../components/ClientLogos.astro';

const stepsEn = [
  {
    step: '01',
    title: 'Customer Obsession',
    desc: 'We dive deep into your architecture, mission-critical dependencies, and business objectives to architect a solution that solves real-world operational challenges.'
  },
  {
    step: '02',
    title: 'Architecture & Design',
    desc: 'Our senior engineers design the optimal compute topology, redundant storage tiers, and zero-trust network boundaries, systematically eliminating single points of failure.'
  },
  {
    step: '03',
    title: 'Optimized Migration',
    desc: 'We execute live data transfers and virtual machine cutovers under stringent testing protocols to guarantee seamless, zero-downtime onboarding.'
  },
  {
    step: '04',
    title: '24/7 Managed Operations',
    desc: 'We monitor infrastructure telemetry 24/7/365, delivering instant incident response and ongoing performance optimization.'
  }
];

const pillarsEn = [
  { title: 'Tangible ROI', desc: 'Dramatically reduce cloud spend by eliminating excessive egress bandwidth fees and hyper-scaler lock-in.' },
  { title: 'Privacy & Sovereignty', desc: 'Retain complete ownership and custody of your data in isolated private environments.' },
  { title: 'Compliance & Security', desc: 'Infrastructure engineered to comply with ISO 27001, SOC 2, and international privacy mandates.' },
  { title: 'Workload Consolidation', desc: 'Consolidate disparate systems onto dense, power-efficient, enterprise hypervisors.' },
  { title: 'No Vendor Lock-In', desc: 'Built on open enterprise technology like Proxmox VE, ensuring total flexibility and portability.' },
  { title: 'Superior Performance', desc: 'State-of-the-art enterprise hardware powered by AMD EPYC / Intel Xeon and All-Flash NVMe.' }
];
---

<Layout
  title="About Us | KloudXP"
  description="Learn more about Kloud Xperts: strategic partners in cloud infrastructure, dedicated virtualization, and business continuity."
  lang="en"
>
  <section class="py-20 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-mono uppercase tracking-widest text-sky-400 bg-sky-950/60 px-3.5 py-1 rounded-full border border-sky-800/60">
        Our Mission
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Strategic Partners for Your Digital Transformation
      </h1>
      <p class="text-slate-400 text-lg max-w-3xl mx-auto leading-relaxed">
        We build and manage scalable, secure, and resilient cloud infrastructure for enterprises that cannot afford downtime.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6">
          <h2 class="text-3xl font-extrabold text-white">Strategy, Design, and Impact</h2>
          <p class="text-slate-300 text-base leading-relaxed">
            Strategically positioned to serve enterprises across Mexico, Colombia, and North America, with active operations in Guadalajara and Bogota, operating high-availability server clusters housed in certified Tier III/IV data center facilities.
          </p>
          <p class="text-slate-400 text-sm leading-relaxed">
            Unlike legacy hyperscalers where you are just an account number, KloudXP pairs your organization with dedicated senior engineers who know your stack inside and out.
          </p>
          <div class="p-4 bg-slate-900/90 border border-slate-800 rounded-2xl space-y-2">
            <div class="text-xs font-mono uppercase tracking-wider text-cyan-400 font-semibold flex items-center">
              <span class="mr-2">🌎</span> Regional Hubs: Mexico & Colombia
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              With local engineering and support in <strong class="text-white">Guadalajara (Mexico)</strong> and <strong class="text-white">Bogota (Colombia)</strong>, we deliver ultra-low latency connectivity and hands-on consulting across the Americas.
            </p>
          </div>
        </div>
        <div class="lg:col-span-6 bg-slate-900/80 border border-slate-800 rounded-3xl p-8 space-y-6 shadow-xl">
          <h3 class="text-xl font-bold text-white border-b border-slate-800 pb-3">Core Pillars</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {pillarsEn.map((p) => (
              <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800/80 space-y-1">
                <div class="text-xs font-bold text-sky-400">{p.title}</div>
                <div class="text-[11px] text-slate-400 leading-snug">{p.desc}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-950/80 border-y border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 bg-cyan-950/60 px-3.5 py-1 rounded-full border border-cyan-800/60">
          Proven Methodology
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          A Customized Process is the Foundation of Everything
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {stepsEn.map((item) => (
          <div class="bg-slate-900/60 border border-slate-800/90 rounded-2xl p-6 relative flex flex-col justify-between hover:border-sky-500/40 transition-all group">
            <div class="space-y-3">
              <div class="text-3xl font-black font-mono text-sky-500/40 group-hover:text-sky-400 transition-colors">{item.step}</div>
              <h3 class="text-lg font-bold text-white group-hover:text-sky-300 transition-colors">{item.title}</h3>
              <p class="text-xs text-slate-400 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ClientLogos lang="en" />
</Layout>
