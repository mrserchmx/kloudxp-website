---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Testimonials from '../components/Testimonials.astro';

const services = [
  {
    title: 'Nube Privada Dedicada',
    badge: 'Proxmox Official Partner',
    description: 'Infraestructura de virtualización 100% aislada y dedicada. Rendimiento constante sin vecinos ruidosos, alta disponibilidad Ceph y control total de hipervisor.',
    features: [
      'Clústeres dedicados Proxmox VE en Alta Disponibilidad (HA)',
      'Almacenamiento hiperconvergente Ceph / ZFS All-Flash NVMe',
      'Cumplimiento estricto de privacidad y normativas locales',
      'Acceso raíz completo y orquestación personalizada'
    ],
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>`,
    href: '/servicios#nube-privada'
  },
  {
    title: 'Nube Pública para Máquinas Virtuales',
    badge: 'Escalabilidad Elástica',
    description: 'Cómputo en la nube bajo demanda para cargas dinámicas. Despliegue instancias KVM en segundos con facturación predecible y conectividad redundante.',
    features: [
      'Escalado horizontal y vertical instantáneo',
      'Balanceo de carga y redes privadas virtuales (VPC)',
      'Precios transparentes sin costos ocultos de transferencia',
      'Red BGP multicarrier con protección DDoS'
    ],
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/></svg>`,
    href: '/servicios#nube-publica'
  },
  {
    title: 'File & Block Storage NVMe',
    badge: 'Ultra Baja Latencia',
    description: 'Volúmenes de almacenamiento de alto rendimiento para bases de datos, aplicaciones críticas y repositorios compartidos con soporte multiprotocolo.',
    features: [
      '100,000+ IOPS por volumen con discos NVMe de nivel enterprise',
      'Compatibilidad nativa con protocolos NFS, SMB/CIFS e iSCSI',
      'Snapshots automáticos a nivel de bloque sin degradación',
      'Cifrado en tránsito y en reposo (AES-256)'
    ],
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>`,
    href: '/servicios#storage'
  },
  {
    title: 'Protección de Datos & DRP',
    badge: 'Anti-Ransomware',
    description: 'Soluciones avanzadas de continuidad de negocio y recuperación ante desastres con Proxmox Backup Server. Respaldos inmutables y tiempos RTO mínimos.',
    features: [
      'Respaldos inmutables que previenen el cifrado malicioso',
      'Deduplicación inteligente que reduce hasta 85% de espacio',
      'Restauración granular de archivos o máquinas virtuales completas',
      'RTO y RPO cercanos a cero para aplicaciones críticas'
    ],
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    href: '/servicios#proteccion-datos'
  },
  {
    title: 'Co-locación de Servidores (Colocation)',
    badge: 'Centros de Datos Tier III/IV',
    description: 'Espacio seguro y confiable para su propio hardware en centros de datos de clase mundial Tier III/IV en Guadalajara, CDMX y Estados Unidos.',
    features: [
      'Gabinetes completos (42U), medios racks o unidades individuales',
      'Redundancia eléctrica 2N (UPS + Generadores diésel)',
      'Control de acceso biométrico, videovigilancia 24/7 y jaulas de seguridad',
      'Conectividad con las principales redes y puntos de intercambio IXP'
    ],
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
    href: '/servicios#colocation'
  },
  {
    title: 'Servicios Profesionales & Soporte 24/7',
    badge: 'Ingeniería Especializada',
    description: 'Acompañamiento integral desde la consultoría y diseño de arquitectura cloud hasta la migración en caliente y la administración proactiva.',
    features: [
      'Ingenieros certificados Proxmox, Linux y Redes disponibles 24/7',
      'Migraciones asistidas con cero ventanas de caída para su negocio',
      'Auditorías de optimización de costos y dimensionamiento',
      'Monitoreo proactivo de telemetría, métricas y seguridad'
    ],
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>`,
    href: '/servicios#profesionales'
  }
];
---

<Layout
  title="KloudXP | Infraestructura Cloud, Nube Privada Proxmox y Servicios Gestionados"
  description="Líder en soluciones de Nube Privada Dedicada con Proxmox VE, Nube Pública, Almacenamiento NVMe y Co-locación en centros de datos certificados en México y Norteamérica."
  lang="es"
>
  <!-- Hero Section -->
  <Hero lang="es" />

  <!-- Client Logos Banner -->
  <ClientLogos lang="es" />

  <!-- Core Services Section -->
  <section id="servicios" class="py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="text-xs font-mono uppercase tracking-widest text-sky-400 bg-sky-950/60 px-3.5 py-1 rounded-full border border-sky-800/60">
          Portafolio de Soluciones
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Infraestructura de Nivel Empresarial Diseñada para Escalar
        </h2>
        <p class="text-slate-400 text-base">
          Proporcionamos el equilibrio perfecto entre rendimiento, seguridad y eficiencia en costos, con soporte humano en español 24/7.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((s) => (
          <ServiceCard
            title={s.title}
            badge={s.badge}
            description={s.description}
            features={s.features}
            icon={s.icon}
            href={s.href}
            lang="es"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Strategic Alliances Highlight -->
  <section class="py-20 bg-gradient-to-b from-slate-950 to-slate-900 border-y border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 bg-cyan-950/60 px-3 py-1 rounded-full border border-cyan-800/60">
            Respaldo Tecnológico Global
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            Alianzas Estratégicas de Clase Mundial
          </h2>
          <p class="text-slate-300 text-base leading-relaxed">
            Nuestra infraestructura no depende de intermediarios opacos. Operamos directamente con tecnología de código abierto empresarial de <strong class="text-white">Proxmox Server Solutions</strong> y centros de datos de última generación de alta disponibilidad Tier III y Tier IV.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 bg-slate-900/90 rounded-xl border border-slate-800 space-y-2">
              <div class="text-sky-400 font-bold text-sm">Proxmox Official Partner</div>
              <p class="text-xs text-slate-400">Ingeniería certificada para diseñar, implementar y soportar clústeres de misión crítica con Proxmox VE y PBS.</p>
            </div>
            <div class="p-4 bg-slate-900/90 rounded-xl border border-slate-800 space-y-2">
              <div class="text-cyan-400 font-bold text-sm">Centros de Datos Tier III/IV</div>
              <p class="text-xs text-slate-400">Instalaciones con redundancia 2N, certificaciones ISO 27001, SOC 2 y baja latencia hacia México y EE.UU.</p>
            </div>
          </div>
        </div>

        <div class="bg-slate-950 p-8 rounded-2xl border border-slate-800 shadow-xl space-y-6">
          <div class="text-center pb-4 border-b border-slate-800">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400">Tecnología Certificada</h3>
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-6 py-4">
            <div class="p-4 bg-slate-900 rounded-xl border border-slate-800 flex items-center justify-center w-full sm:w-auto h-20 px-8">
              <img src="/images/partners/proxmox-partner.svg" alt="Proxmox Official Partner" class="h-12 w-auto object-contain" />
            </div>
          </div>
          <div class="text-xs text-slate-400 text-center leading-relaxed">
            Soberanía de datos 100% garantizada, con opción de almacenamiento en territorio nacional mexicano o en centros de datos de Estados Unidos.
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Testimonials Section -->
  <Testimonials lang="es" />

  <!-- Direct CTA Banner -->
  <section class="py-20 relative overflow-hidden bg-gradient-to-r from-sky-950 via-slate-900 to-slate-950 border-t border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 relative z-10">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        ¿Listo para optimizar su infraestructura con KloudXP?
      </h2>
      <p class="text-slate-300 text-base max-w-2xl mx-auto leading-relaxed">
        Nuestros ingenieros de soluciones analizarán su arquitectura actual y le presentarán una propuesta de migración sin interrupciones ni costos ocultos.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 pt-4">
        <a
          href="/contacto"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-gradient-to-r from-sky-600 to-cyan-500 hover:from-sky-500 hover:to-cyan-400 rounded-xl shadow-xl shadow-sky-500/25 transition-all transform hover:-translate-y-0.5 cursor-pointer"
        >
          Hablar con un Ingeniero de Soluciones
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
        <a
          href="tel:+523322334400"
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 text-base font-semibold text-slate-200 bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 rounded-xl transition-all"
        >
          Llamar al +52-33-2233-4400
        </a>
      </div>
    </div>
  </section>
</Layout>
