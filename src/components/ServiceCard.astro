---
interface Props {
  title: string;
  description: string;
  features: string[];
  icon: string;
  href: string;
  badge?: string;
  lang?: 'es' | 'en';
}

const { title, description, features, icon, href, badge, lang = 'es' } = Astro.props;
---

<div class="group relative rounded-2xl bg-slate-900/70 border border-slate-800/80 p-8 hover:border-sky-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-sky-500/10 flex flex-col justify-between overflow-hidden">
  <!-- Glowing gradient on hover -->
  <div class="absolute -top-24 -right-24 w-48 h-48 bg-sky-500/10 rounded-full blur-2xl group-hover:bg-sky-500/20 transition-all duration-300"></div>

  <div>
    <!-- Icon & Badge Header -->
    <div class="flex items-center justify-between mb-6">
      <div class="w-12 h-12 rounded-xl bg-sky-950/80 border border-sky-800/60 flex items-center justify-center text-sky-400 group-hover:scale-110 group-hover:bg-sky-900/60 transition-all duration-300">
        <Fragment set:html={icon} />
      </div>
      {badge && (
        <span class="text-[11px] font-semibold tracking-wide uppercase px-2.5 py-1 rounded-full bg-sky-900/50 text-sky-300 border border-sky-700/50">
          {badge}
        </span>
      )}
    </div>

    <!-- Title & Desc -->
    <h3 class="text-xl font-bold text-white mb-3 group-hover:text-sky-400 transition-colors">
      {title}
    </h3>
    <p class="text-slate-400 text-sm leading-relaxed mb-6">
      {description}
    </p>

    <!-- Key Bullet Features -->
    <ul class="space-y-2.5 mb-8">
      {features.map((feat) => (
        <li class="flex items-start text-xs text-slate-300">
          <svg class="w-4 h-4 text-sky-400 mr-2 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>{feat}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Bottom Action Link -->
  <a
    href={href}
    class="inline-flex items-center text-sm font-semibold text-sky-400 group-hover:text-sky-300 group-hover:translate-x-1 transition-all"
  >
    <span>{lang === 'es' ? 'Ver especificaciones' : 'View specifications'}</span>
    <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </a>
</div>
