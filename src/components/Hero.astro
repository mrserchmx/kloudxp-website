---
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const basePrefix = lang === 'es' ? '' : '/en';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left text column -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Partner Badge -->
        <div class="inline-flex items-center space-x-2 bg-sky-950/60 border border-sky-500/30 px-3.5 py-1.5 rounded-full text-xs font-medium text-sky-300 shadow-sm backdrop-blur-sm">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"></span>
          </span>
          <span>{t('hero.badge')}</span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12]">
          {lang === 'es' ? (
            <>
              Infraestructura Cloud de <span class="bg-gradient-to-r from-sky-400 via-cyan-300 to-blue-500 bg-clip-text text-transparent">Alto Rendimiento</span> para su Empresa
            </>
          ) : (
            <>
              High-Performance <span class="bg-gradient-to-r from-sky-400 via-cyan-300 to-blue-500 bg-clip-text text-transparent">Cloud Infrastructure</span> for Your Business
            </>
          )}
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
          {t('hero.subtitle')}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start space-y-3 sm:space-y-0 sm:space-x-4 pt-2">
          <a
            href={`${basePrefix}/precios`}
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-white bg-gradient-to-r from-sky-600 to-cyan-500 hover:from-sky-500 hover:to-cyan-400 rounded-xl shadow-lg shadow-sky-500/25 hover:shadow-sky-500/40 transition-all transform hover:-translate-y-0.5"
          >
            {t('hero.cta.quote')}
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href={`${basePrefix}/servicios`}
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-slate-200 bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 rounded-xl transition-all"
          >
            {t('hero.cta.services')}
          </a>
        </div>

        <!-- Mini trust bullet -->
        <div class="pt-4 flex items-center justify-center lg:justify-start space-x-6 text-xs text-slate-400">
          <span class="flex items-center">
            <svg class="w-4 h-4 text-sky-400 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            {lang === 'es' ? 'Centros de datos en México y EE.UU.' : 'Data centers in Mexico & US'}
          </span>
          <span class="flex items-center">
            <svg class="w-4 h-4 text-sky-400 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            {lang === 'es' ? 'Migración asistida sin caídas' : 'Zero-downtime migration'}
          </span>
        </div>
      </div>

      <!-- Right interactive tech card illustration -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Glassmorphic Tech Monitor Card -->
          <div class="rounded-2xl bg-gradient-to-b from-slate-900/90 to-slate-950/90 border border-slate-700/60 p-6 shadow-2xl backdrop-blur-xl space-y-6">
            <!-- Header bar of card -->
            <div class="flex items-center justify-between border-b border-slate-800 pb-4">
              <div class="flex items-center space-x-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
                <span class="text-xs font-mono text-slate-400 ml-2">cloud-core-node-01</span>
              </div>
              <span class="text-xs font-mono text-emerald-400 bg-emerald-950/80 border border-emerald-800/60 px-2 py-0.5 rounded">
                ONLINE
              </span>
            </div>

            <!-- Virtual cluster status list -->
            <div class="space-y-3 font-mono text-xs">
              <!-- Node 1 -->
              <div class="p-3 bg-slate-950/60 rounded-lg border border-slate-800/80 flex items-center justify-between">
                <div>
                  <div class="text-slate-200 font-semibold flex items-center">
                    <span class="text-sky-400 mr-2">●</span> Nube Privada Proxmox VE
                  </div>
                  <div class="text-slate-400 text-[11px]">HA Cluster • NVMe Ceph Storage</div>
                </div>
                <div class="text-right">
                  <div class="text-emerald-400 font-bold">99.999%</div>
                  <div class="text-slate-500 text-[10px]">Uptime SLA</div>
                </div>
              </div>

              <!-- Node 2 -->
              <div class="p-3 bg-slate-950/60 rounded-lg border border-slate-800/80 flex items-center justify-between">
                <div>
                  <div class="text-slate-200 font-semibold flex items-center">
                    <span class="text-cyan-400 mr-2">●</span> DRP & Inmutable Backups
                  </div>
                  <div class="text-slate-400 text-[11px]">Proxmox Backup Server (PBS)</div>
                </div>
                <div class="text-right">
                  <div class="text-sky-400 font-bold">&lt; 1 min</div>
                  <div class="text-slate-500 text-[10px]">RTO Snapshot</div>
                </div>
              </div>

              <!-- Node 3 -->
              <div class="p-3 bg-slate-950/60 rounded-lg border border-slate-800/80 flex items-center justify-between">
                <div>
                  <div class="text-slate-200 font-semibold flex items-center">
                    <span class="text-indigo-400 mr-2">●</span> HostDime Tier III Facility
                  </div>
                  <div class="text-slate-400 text-[11px]">Redundancia Eléctrica 2N + BGP</div>
                </div>
                <div class="text-right">
                  <div class="text-emerald-400 font-bold">&lt; 12ms</div>
                  <div class="text-slate-500 text-[10px]">Edge Latency</div>
                </div>
              </div>
            </div>

            <!-- Visual resource meters -->
            <div class="pt-2 border-t border-slate-800/80 space-y-3">
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-slate-400">Capacidad de Cómputo (vCPU Core Pool)</span>
                  <span class="text-sky-400 font-mono font-medium">99.4% Eficiencia</span>
                </div>
                <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-sky-500 to-cyan-400 rounded-full" style="width: 78%"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-slate-400">Almacenamiento NVMe All-Flash (IOPS)</span>
                  <span class="text-cyan-400 font-mono font-medium">100K+ IOPS</span>
                </div>
                <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-cyan-500 to-emerald-400 rounded-full" style="width: 85%"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Decorative glowing backdrops -->
          <div class="absolute -inset-1 bg-gradient-to-r from-sky-500/20 to-cyan-500/20 rounded-2xl blur-lg -z-10 opacity-70"></div>
        </div>
      </div>
    </div>

    <!-- Stats row -->
    <div class="mt-16 pt-10 border-t border-slate-800/70 grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="text-center md:text-left">
        <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{t('stats.uptime')}</div>
        <div class="text-sm text-slate-400 mt-1">{t('stats.uptime.label')}</div>
      </div>
      <div class="text-center md:text-left">
        <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{t('stats.support')}</div>
        <div class="text-sm text-slate-400 mt-1">{t('stats.support.label')}</div>
      </div>
      <div class="text-center md:text-left">
        <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{t('stats.latency')}</div>
        <div class="text-sm text-slate-400 mt-1">{t('stats.latency.label')}</div>
      </div>
      <div class="text-center md:text-left">
        <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{t('stats.control')}</div>
        <div class="text-sm text-slate-400 mt-1">{t('stats.control.label')}</div>
      </div>
    </div>
  </div>
</section>
