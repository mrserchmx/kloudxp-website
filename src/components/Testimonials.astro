---
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const testimonialsEs = [
  {
    quote: "La asesoría que recibí de Kloud Xperts me ayudó a reducir mis costos mensuales de infraestructura con mayor disponibilidad que mi proveedor anterior.",
    author: "Dirección de TI",
    company: "Empresa de Comercio Electrónico",
    highlight: "Reducción de costos & mayor uptime"
  },
  {
    quote: "Trabajar con KloudXperts ha sido un cambio total para nuestra operación. Nuestra nube privada funciona con un rendimiento óptimo y la seguridad es de primer nivel. Su enfoque proactivo nos permite enfocarnos en los clientes.",
    author: "Gerencia de Operaciones",
    company: "Sector Retail & Distribución",
    highlight: "Rendimiento y seguridad total"
  },
  {
    quote: "Desde que migramos nuestra infraestructura a la nube privada de KloudXperts, experimentamos una mejora radical en estabilidad. El soporte técnico es rápido y preciso; están disponibles siempre.",
    author: "Líder de Infraestructura",
    company: "Servicios Financieros & Fintech",
    highlight: "Soporte técnico 24/7 de excelencia"
  },
  {
    quote: "Nos proporcionaron una solución a la medida con Proxmox y nos guiaron paso a paso en la migración sin interrupciones de servicio. Ahora crecemos sin preocuparnos por caídas de servidores.",
    author: "Chief Technology Officer",
    company: "Software as a Service (SaaS)",
    highlight: "Migración transparente sin caídas"
  }
];

const testimonialsEn = [
  {
    quote: "The guidance we received from Kloud Xperts helped us reduce our monthly cloud infrastructure spend while delivering significantly higher availability than our previous hosting provider.",
    author: "IT Director",
    company: "E-commerce Enterprise",
    highlight: "Cost reduction & higher uptime"
  },
  {
    quote: "Partnering with KloudXperts has been a total game changer for our operations. Our private cloud delivers exceptional performance and enterprise-grade security.",
    author: "Operations Management",
    company: "Retail & Supply Chain",
    highlight: "Optimal performance & security"
  },
  {
    quote: "Ever since migrating our infrastructure to KloudXperts' hosted private cloud, our system stability has been rock-solid. Their engineering support is fast, attentive, and dependable.",
    author: "Infrastructure Lead",
    company: "Fintech & Financial Services",
    highlight: "24/7 dedicated engineering support"
  },
  {
    quote: "They designed a custom Proxmox cluster solution for us and executed a seamless, zero-downtime migration. Highly recommended for any mission-critical workload.",
    author: "Chief Technology Officer",
    company: "SaaS & Digital Platform",
    highlight: "Zero-downtime cloud migration"
  }
];

const list = lang === 'es' ? testimonialsEs : testimonialsEn;
---

<section class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-sky-400 bg-sky-950/60 px-3 py-1 rounded-full border border-sky-800/60">
        {t('testimonials.title')}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 tracking-tight">
        {t('testimonials.subtitle')}
      </h2>
    </div>

    <!-- Testimonial Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {list.map((item) => (
        <div class="bg-gradient-to-br from-slate-900/90 to-slate-950/90 border border-slate-800/90 p-8 rounded-2xl relative flex flex-col justify-between hover:border-sky-500/40 transition-all duration-300 shadow-lg">
          <div>
            <!-- Star rating -->
            <div class="flex items-center space-x-1 text-amber-400 mb-4">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
              <span class="text-xs font-mono text-sky-400 font-semibold ml-2">"{item.highlight}"</span>
            </div>
            <!-- Quote -->
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed italic mb-6">
              "{item.quote}"
            </p>
          </div>

          <!-- Author details -->
          <div class="flex items-center space-x-3 pt-4 border-t border-slate-800/80">
            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-sky-600 to-cyan-400 flex items-center justify-center font-bold text-white text-sm shadow-md">
              {item.author.charAt(0)}
            </div>
            <div>
              <div class="text-white text-sm font-semibold">{item.author}</div>
              <div class="text-xs text-slate-400">{item.company}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
