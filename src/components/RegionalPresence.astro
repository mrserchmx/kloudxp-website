---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const content = {
  es: {
    badge: 'Expansión Regional • LATAM',
    title: 'Presencia Local en México y Colombia',
    subtitle: 'Fortalecemos la infraestructura tecnológica en América Latina con presencia operativa directa, centros de datos certificados y equipos de ingeniería local en Guadalajara y Bogotá.',
    mexico: {
      country: 'México',
      flag: '🇲🇽',
      city: 'Guadalajara / Zapopan',
      badge: 'Sede Central & Data Centers',
      address: 'Av. de las Américas 320, Altamira, 45160 Zapopan, Jalisco, México',
      phone: '+52-33-2233-4400',
      phoneRaw: '+523322334400',
      features: [
        'Sede corporativa y clústeres de Nube Privada Proxmox VE',
        'Centros de datos de alta disponibilidad con redundancia 2N',
        'Interconexión directa a fibra óptica y peering IXP México',
        'Facturación en Pesos Mexicanos (MXN con CFDI) o USD',
        'Ingeniería y soporte técnico de guardia 24/7/365'
      ],
      callAction: 'Llamar a Guadalajara'
    },
    colombia: {
      country: 'Colombia',
      flag: '🇨🇴',
      city: 'Bogotá D.C.',
      badge: 'Nuevas Operaciones & Hub Andino',
      address: 'Presencia y Operaciones Locales en Bogotá D.C., Colombia',
      phone: '+57-3134716622',
      phoneRaw: '+573134716622',
      features: [
        'Expansión estratégica y presencia operativa en Bogotá D.C.',
        'Conectividad de ultra-baja latencia hacia la región Andina y Sudamérica',
        'Asesoría técnica y atención comercial personalizada en horario local',
        'Replicación geográfica y DRP transfronterizo México ↔ Colombia',
        'Atención inmediata en español para empresas y corporativos colombianos'
      ],
      callAction: 'Llamar a Bogotá'
    },
    benefits: [
      {
        title: 'Baja Latencia Inter-Regional',
        desc: 'Rutas de tránsito y fibra optimizadas para garantizar tiempos de respuesta mínimos entre México, Centroamérica y Colombia.'
      },
      {
        title: 'Soporte Humano Directo',
        desc: 'Líneas directas en Guadalajara y Bogotá con ingenieros especialistas L3, sin conmutadores confusos ni bots automatizados.'
      },
      {
        title: 'Continuidad & Resiliencia Geográfica',
        desc: 'Diseñe estrategias de Disaster Recovery con respaldo cruzado entre dos territorios para cumplir los más altos estándares de gobernanza.'
      }
    ]
  },
  en: {
    badge: 'Regional Expansion • LATAM',
    title: 'Local Presence in Mexico and Colombia',
    subtitle: 'Strengthening enterprise cloud infrastructure in Latin America with direct operational presence, high-availability data centers, and native engineering teams in Guadalajara and Bogota.',
    mexico: {
      country: 'Mexico',
      flag: '🇲🇽',
      city: 'Guadalajara / Zapopan',
      badge: 'Headquarters & Core Data Centers',
      address: 'Av. de las Américas 320, Altamira, 45160 Zapopan, Jalisco, Mexico',
      phone: '+52-33-2233-4400',
      phoneRaw: '+523322334400',
      features: [
        'Corporate headquarters & clustered Proxmox VE Private Cloud',
        'Tier III/IV facility standards with 2N electrical redundancy',
        'Direct optical fiber interconnects and Mexico IXP peering',
        'Local invoicing (MXN CFDI compliant) or USD billing',
        '24/7/365 dedicated senior engineering on duty'
      ],
      callAction: 'Call Guadalajara'
    },
    colombia: {
      country: 'Colombia',
      flag: '🇨🇴',
      city: 'Bogota D.C.',
      badge: 'New Operations & Andean Hub',
      address: 'Local Operations & Business Presence in Bogota D.C., Colombia',
      phone: '+57-3134716622',
      phoneRaw: '+573134716622',
      features: [
        'Strategic operational expansion and local presence in Bogota D.C.',
        'Ultra-low latency routing to the Andean Region & South America',
        'Dedicated commercial and technical consulting in local business hours',
        'Cross-border geographic replication & DRP between Mexico ↔ Colombia',
        'Native engineering support for Colombian and multinational enterprises'
      ],
      callAction: 'Call Bogota'
    },
    benefits: [
      {
        title: 'Inter-Regional Low Latency',
        desc: 'Optimized fiber backbones providing minimal transit times between Mexico, Central America, and Colombia.'
      },
      {
        title: 'Direct Human Engineering',
        desc: 'Direct phone lines in Guadalajara and Bogota with certified L3 engineers, no confusing IVRs or automated bots.'
      },
      {
        title: 'Geographic Resilience & DRP',
        desc: 'Deploy resilient multi-country disaster recovery architectures that comply with international data security standards.'
      }
    ]
  }
};

const c = lang === 'es' ? content.es : content.en;
---

<section class="py-20 bg-gradient-to-b from-slate-900/60 via-slate-950 to-slate-900/80 border-y border-slate-800 relative overflow-hidden">
  <!-- Subtle background glow -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 bg-cyan-950/70 px-4 py-1.5 rounded-full border border-cyan-800/60 inline-flex items-center space-x-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>{c.badge}</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        {c.title}
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {c.subtitle}
      </p>
    </div>

    <!-- Country Hubs Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
      <!-- Mexico Hub Card -->
      <div class="bg-slate-900/80 border border-slate-800 hover:border-sky-500/50 rounded-3xl p-8 sm:p-10 transition-all duration-300 shadow-xl flex flex-col justify-between group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-sky-500/5 rounded-bl-full pointer-events-none"></div>
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <span class="text-3xl" role="img" aria-label="Bandera de México">{c.mexico.flag}</span>
              <div>
                <h3 class="text-2xl font-bold text-white group-hover:text-sky-300 transition-colors">{c.mexico.city}</h3>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">{c.mexico.country}</span>
              </div>
            </div>
            <span class="text-[11px] font-mono text-sky-400 bg-sky-950/80 border border-sky-800/60 px-3 py-1 rounded-full">
              {c.mexico.badge}
            </span>
          </div>

          <p class="text-xs text-slate-400 leading-relaxed flex items-start">
            <svg class="w-4 h-4 text-sky-400 mr-2 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{c.mexico.address}</span>
          </p>

          <ul class="space-y-2.5 pt-2 border-t border-slate-800/80">
            {c.mexico.features.map((item) => (
              <li class="flex items-start text-xs sm:text-sm text-slate-300">
                <svg class="w-4 h-4 text-sky-400 mr-2.5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pt-6 mt-6 border-t border-slate-800/80 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center text-sm font-semibold text-white">
            <svg class="w-4 h-4 text-sky-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${c.mexico.phoneRaw}`} class="hover:text-sky-400 transition-colors font-mono">
              {c.mexico.phone}
            </a>
          </div>
          <a
            href={`tel:${c.mexico.phoneRaw}`}
            class="inline-flex items-center justify-center px-4 py-2 text-xs font-bold text-white bg-sky-600/90 hover:bg-sky-500 rounded-xl transition-all shadow-md shadow-sky-600/20"
          >
            {c.mexico.callAction}
          </a>
        </div>
      </div>

      <!-- Colombia Hub Card -->
      <div class="bg-slate-900/80 border border-slate-800 hover:border-cyan-500/50 rounded-3xl p-8 sm:p-10 transition-all duration-300 shadow-xl flex flex-col justify-between group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-cyan-500/5 rounded-bl-full pointer-events-none"></div>
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <span class="text-3xl" role="img" aria-label="Bandera de Colombia">{c.colombia.flag}</span>
              <div>
                <h3 class="text-2xl font-bold text-white group-hover:text-cyan-300 transition-colors">{c.colombia.city}</h3>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">{c.colombia.country}</span>
              </div>
            </div>
            <span class="text-[11px] font-mono text-cyan-400 bg-cyan-950/80 border border-cyan-800/60 px-3 py-1 rounded-full">
              {c.colombia.badge}
            </span>
          </div>

          <p class="text-xs text-slate-400 leading-relaxed flex items-start">
            <svg class="w-4 h-4 text-cyan-400 mr-2 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{c.colombia.address}</span>
          </p>

          <ul class="space-y-2.5 pt-2 border-t border-slate-800/80">
            {c.colombia.features.map((item) => (
              <li class="flex items-start text-xs sm:text-sm text-slate-300">
                <svg class="w-4 h-4 text-cyan-400 mr-2.5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pt-6 mt-6 border-t border-slate-800/80 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div class="flex items-center text-sm font-semibold text-white">
            <svg class="w-4 h-4 text-cyan-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href={`tel:${c.colombia.phoneRaw}`} class="hover:text-cyan-400 transition-colors font-mono">
              {c.colombia.phone}
            </a>
          </div>
          <a
            href={`tel:${c.colombia.phoneRaw}`}
            class="inline-flex items-center justify-center px-4 py-2 text-xs font-bold text-white bg-cyan-600/90 hover:bg-cyan-500 rounded-xl transition-all shadow-md shadow-cyan-600/20"
          >
            {c.colombia.callAction}
          </a>
        </div>
      </div>
    </div>

    <!-- 3 Value Props Bar -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
      {c.benefits.map((b) => (
        <div class="bg-slate-900/50 border border-slate-800/80 rounded-2xl p-6 space-y-2">
          <h4 class="text-sm font-bold text-white flex items-center">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 mr-2"></span>
            {b.title}
          </h4>
          <p class="text-xs text-slate-400 leading-relaxed">{b.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
