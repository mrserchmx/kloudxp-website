---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
---

<div class="bg-gradient-to-b from-slate-900/95 to-slate-950/95 border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-md">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-10">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 bg-cyan-950/60 px-3 py-1 rounded-full border border-cyan-800/60">
        {lang === 'es' ? 'Calculadora de Recursos Cloud' : 'Cloud Resource Estimator'}
      </span>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white mt-3">
        {lang === 'es' ? 'Dimensione su Infraestructura en la Nube' : 'Estimate Your Infrastructure Footprint'}
      </h3>
      <p class="text-slate-400 text-sm mt-2 max-w-xl mx-auto">
        {lang === 'es' 
          ? 'Personalice la capacidad de cómputo, memoria y almacenamiento NVMe según las cargas de trabajo de su empresa.'
          : 'Customize compute cores, memory, and NVMe enterprise storage to match your workload needs.'}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Sliders Column -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Architecture Choice -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            {lang === 'es' ? 'Tipo de Entorno' : 'Deployment Type'}
          </label>
          <div class="grid grid-cols-2 gap-3">
            <button
              type="button"
              id="type-private"
              class="calc-type-btn active py-3 px-4 rounded-xl text-xs sm:text-sm font-semibold border transition-all text-center flex flex-col items-center justify-center bg-sky-950/80 border-sky-500 text-sky-300 shadow-md shadow-sky-500/10 cursor-pointer"
            >
              <span>{lang === 'es' ? 'Nube Privada Dedicada' : 'Dedicated Private Cloud'}</span>
              <span class="text-[10px] text-slate-400 font-normal mt-0.5">Proxmox VE Clustered</span>
            </button>
            <button
              type="button"
              id="type-public"
              class="calc-type-btn py-3 px-4 rounded-xl text-xs sm:text-sm font-semibold border transition-all text-center flex flex-col items-center justify-center bg-slate-900 border-slate-800 text-slate-400 hover:border-slate-700 cursor-pointer"
            >
              <span>{lang === 'es' ? 'Nube Pública / VMs' : 'Public Cloud / VMs'}</span>
              <span class="text-[10px] text-slate-500 font-normal mt-0.5">Instancias KVM</span>
            </button>
          </div>
        </div>

        <!-- vCPU Slider -->
        <div class="space-y-2">
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-300 font-medium">{lang === 'es' ? 'Cómputo vCPU Cores' : 'vCPU Compute Cores'}</span>
            <span id="val-cpu" class="font-mono text-sky-400 font-bold text-base">8 Cores</span>
          </div>
          <input
            type="range"
            id="slider-cpu"
            min="2"
            max="64"
            step="2"
            value="8"
            class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-sky-500"
          />
          <div class="flex justify-between text-[10px] font-mono text-slate-500">
            <span>2 Cores</span>
            <span>16 Cores</span>
            <span>32 Cores</span>
            <span>64 Cores</span>
          </div>
        </div>

        <!-- RAM Slider -->
        <div class="space-y-2">
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-300 font-medium">{lang === 'es' ? 'Memoria RAM DDR4/DDR5 ECC' : 'ECC RAM Memory'}</span>
            <span id="val-ram" class="font-mono text-cyan-400 font-bold text-base">32 GB</span>
          </div>
          <input
            type="range"
            id="slider-ram"
            min="8"
            max="256"
            step="8"
            value="32"
            class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-500"
          />
          <div class="flex justify-between text-[10px] font-mono text-slate-500">
            <span>8 GB</span>
            <span>64 GB</span>
            <span>128 GB</span>
            <span>256 GB</span>
          </div>
        </div>

        <!-- Storage NVMe Slider -->
        <div class="space-y-2">
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-300 font-medium">{lang === 'es' ? 'Almacenamiento NVMe All-Flash' : 'NVMe All-Flash Storage'}</span>
            <span id="val-disk" class="font-mono text-emerald-400 font-bold text-base">500 GB</span>
          </div>
          <input
            type="range"
            id="slider-disk"
            min="100"
            max="4000"
            step="100"
            value="500"
            class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500"
          />
          <div class="flex justify-between text-[10px] font-mono text-slate-500">
            <span>100 GB</span>
            <span>1 TB (1000 GB)</span>
            <span>2 TB</span>
            <span>4 TB</span>
          </div>
        </div>

        <!-- DRP Checkbox -->
        <div class="p-4 bg-slate-950/70 rounded-xl border border-slate-800/80 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <input
              type="checkbox"
              id="check-drp"
              checked
              class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-sky-600 focus:ring-sky-500"
            />
            <div>
              <div class="text-sm font-semibold text-slate-200">
                {lang === 'es' ? 'Respaldos Inmutables Proxmox Backup Server (PBS)' : 'Immutable PBS Backups'}
              </div>
              <div class="text-xs text-slate-400">
                {lang === 'es' ? 'Deduplicación, cifrado de origen y protección anti-ransomware' : 'Deduplication, encryption and anti-ransomware protection'}
              </div>
            </div>
          </div>
          <span class="text-xs font-mono text-emerald-400 bg-emerald-950/80 border border-emerald-800/50 px-2 py-0.5 rounded">
            Recomendado
          </span>
        </div>
      </div>

      <!-- Output Summary Box -->
      <div class="lg:col-span-5 bg-slate-950/90 border border-slate-800/90 rounded-2xl p-6 sm:p-8 space-y-6 flex flex-col justify-between h-full">
        <div>
          <div class="text-xs font-mono uppercase tracking-wider text-slate-400 border-b border-slate-800 pb-3">
            {lang === 'es' ? 'Resumen de Configuración' : 'Configuration Summary'}
          </div>

          <!-- Specs recap -->
          <div class="py-4 space-y-3 font-mono text-xs">
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">Modalidad:</span>
              <span id="summary-type" class="font-bold text-sky-400">Nube Privada</span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">Cómputo:</span>
              <span id="summary-cpu" class="font-bold text-slate-100">8 vCPU Cores</span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">Memoria RAM:</span>
              <span id="summary-ram" class="font-bold text-slate-100">32 GB ECC</span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">Almacenamiento:</span>
              <span id="summary-disk" class="font-bold text-slate-100">500 GB NVMe</span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">DRP / PBS Backup:</span>
              <span id="summary-drp" class="font-bold text-emerald-400">Incluido</span>
            </div>
            <div class="flex justify-between text-slate-300">
              <span class="text-slate-400">Soporte y SLA:</span>
              <span class="font-bold text-sky-400">24/7 / 99.99%</span>
            </div>
          </div>

          <!-- Value highlights -->
          <div class="p-3 bg-sky-950/40 rounded-lg border border-sky-800/40 text-[11px] text-sky-200 space-y-1">
            <div class="flex items-center"><span class="mr-1.5">✓</span> Tráfico sin costes sorpresa de egress</div>
            <div class="flex items-center"><span class="mr-1.5">✓</span> IP pública dedicada incluida</div>
            <div class="flex items-center"><span class="mr-1.5">✓</span> Soporte en español por ingenieros L3</div>
          </div>
        </div>

        <!-- Action Button -->
        <div class="pt-4 border-t border-slate-800/80">
          <a
            id="quote-cta-btn"
            href={`/contacto?servicio=nube-privada&cpu=8&ram=32&disco=500`}
            class="w-full inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-gradient-to-r from-sky-600 to-cyan-500 hover:from-sky-500 hover:to-cyan-400 rounded-xl shadow-lg shadow-sky-500/20 hover:shadow-sky-500/35 transition-all text-center cursor-pointer"
          >
            {lang === 'es' ? 'Solicitar Cotización Formal' : 'Request Formal Proposal'}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <p class="text-[11px] text-center text-slate-500 mt-2">
            {lang === 'es' ? 'Respuesta y dimensionamiento técnico en menos de 24 horas.' : 'Engineering review and proposal within 24 hours.'}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const typePrivate = document.getElementById('type-private');
  const typePublic = document.getElementById('type-public');
  const sliderCpu = document.getElementById('slider-cpu') as HTMLInputElement;
  const sliderRam = document.getElementById('slider-ram') as HTMLInputElement;
  const sliderDisk = document.getElementById('slider-disk') as HTMLInputElement;
  const checkDrp = document.getElementById('check-drp') as HTMLInputElement;

  const valCpu = document.getElementById('val-cpu');
  const valRam = document.getElementById('val-ram');
  const valDisk = document.getElementById('val-disk');

  const summaryType = document.getElementById('summary-type');
  const summaryCpu = document.getElementById('summary-cpu');
  const summaryRam = document.getElementById('summary-ram');
  const summaryDisk = document.getElementById('summary-disk');
  const summaryDrp = document.getElementById('summary-drp');
  const quoteCtaBtn = document.getElementById('quote-cta-btn') as HTMLAnchorElement;

  let currentType = 'nube-privada';

  function update() {
    const cpu = sliderCpu.value;
    const ram = sliderRam.value;
    const disk = sliderDisk.value;
    const hasDrp = checkDrp.checked;

    if (valCpu) valCpu.textContent = `${cpu} Cores`;
    if (valRam) valRam.textContent = `${ram} GB`;
    if (valDisk) valDisk.textContent = Number(disk) >= 1000 ? `${(Number(disk)/1000).toFixed(1)} TB` : `${disk} GB`;

    if (summaryCpu) summaryCpu.textContent = `${cpu} vCPU Cores`;
    if (summaryRam) summaryRam.textContent = `${ram} GB ECC`;
    if (summaryDisk) summaryDisk.textContent = Number(disk) >= 1000 ? `${(Number(disk)/1000).toFixed(1)} TB NVMe` : `${disk} GB NVMe`;
    if (summaryDrp) summaryDrp.textContent = hasDrp ? 'Incluido' : 'No seleccionado';

    if (quoteCtaBtn) {
      quoteCtaBtn.href = `/contacto?servicio=${currentType}&cpu=${cpu}&ram=${ram}&disco=${disk}&drp=${hasDrp ? 'si' : 'no'}`;
    }
  }

  typePrivate?.addEventListener('click', () => {
    currentType = 'nube-privada';
    typePrivate.className = 'calc-type-btn active py-3 px-4 rounded-xl text-xs sm:text-sm font-semibold border transition-all text-center flex flex-col items-center justify-center bg-sky-950/80 border-sky-500 text-sky-300 shadow-md shadow-sky-500/10 cursor-pointer';
    typePublic?.classList.remove('active', 'bg-sky-950/80', 'border-sky-500', 'text-sky-300');
    typePublic?.classList.add('bg-slate-900', 'border-slate-800', 'text-slate-400');
    if (summaryType) summaryType.textContent = 'Nube Privada Proxmox';
    update();
  });

  typePublic?.addEventListener('click', () => {
    currentType = 'nube-publica';
    typePublic.className = 'calc-type-btn active py-3 px-4 rounded-xl text-xs sm:text-sm font-semibold border transition-all text-center flex flex-col items-center justify-center bg-sky-950/80 border-sky-500 text-sky-300 shadow-md shadow-sky-500/10 cursor-pointer';
    typePrivate?.classList.remove('active', 'bg-sky-950/80', 'border-sky-500', 'text-sky-300');
    typePrivate?.classList.add('bg-slate-900', 'border-slate-800', 'text-slate-400');
    if (summaryType) summaryType.textContent = 'Nube Pública / VMs';
    update();
  });

  sliderCpu?.addEventListener('input', update);
  sliderRam?.addEventListener('input', update);
  sliderDisk?.addEventListener('input', update);
  checkDrp?.addEventListener('change', update);

  update();
</script>
