---
interface Props {
  lang?: 'es' | 'en';
  type?: 'contact' | 'quote' | 'abuse';
  sitekey?: string;
}

const { lang = 'es', type = 'contact', sitekey = '1x00000000000000000000AA' } = Astro.props;
---

<div class="bg-gradient-to-b from-slate-900/90 to-slate-950/90 border border-slate-800 rounded-2xl p-6 sm:p-10 shadow-2xl backdrop-blur-sm">
  <form id="kloudxp-contact-form" class="space-y-6">
    <!-- Honeypot for spambots -->
    <div class="hidden" aria-hidden="true">
      <input type="text" name="_hp_company_field" tabindex="-1" autocomplete="off" />
    </div>

    <input type="hidden" name="form_type" value={type} />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Full Name -->
      <div class="space-y-2">
        <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
          {lang === 'es' ? 'Nombre Completo *' : 'Full Name *'}
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder={lang === 'es' ? 'Ej. Ing. Carlos Mendoza' : 'e.g. John Doe'}
          class="w-full bg-slate-950/80 border border-slate-800 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 transition-all outline-none"
        />
      </div>

      <!-- Email -->
      <div class="space-y-2">
        <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
          {lang === 'es' ? 'Correo Electrónico *' : 'Work Email *'}
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="nombre@empresa.com"
          class="w-full bg-slate-950/80 border border-slate-800 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 transition-all outline-none"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Phone -->
      <div class="space-y-2">
        <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
          {lang === 'es' ? 'Teléfono / WhatsApp' : 'Phone Number'}
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="+52 33 0000 0000"
          class="w-full bg-slate-950/80 border border-slate-800 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 transition-all outline-none"
        />
      </div>

      <!-- Service Interest -->
      <div class="space-y-2">
        <label for="service" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
          {lang === 'es' ? 'Solución de Interés' : 'Area of Interest'}
        </label>
        <select
          id="service"
          name="service"
          class="w-full bg-slate-950/80 border border-slate-800 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 rounded-xl px-4 py-3 text-sm text-white transition-all outline-none"
        >
          <option value="nube-privada">{lang === 'es' ? 'Nube Privada Dedicada (Proxmox)' : 'Dedicated Private Cloud'}</option>
          <option value="nube-publica">{lang === 'es' ? 'Nube Pública & Máquinas Virtuales' : 'Public Cloud & VMs'}</option>
          <option value="storage">{lang === 'es' ? 'File & Block Storage NVMe' : 'NVMe File & Block Storage'}</option>
          <option value="proteccion-datos">{lang === 'es' ? 'Protección de Datos & DRP' : 'Data Protection & DRP'}</option>
          <option value="colocation">{lang === 'es' ? 'Co-locación de Servidores (Colocation)' : 'Server Colocation'}</option>
          <option value="consultoria">{lang === 'es' ? 'Servicios Profesionales & Migración' : 'Professional Services & Migration'}</option>
          <option value="otro">{lang === 'es' ? 'Otro requerimiento' : 'Other'}</option>
        </select>
      </div>
    </div>

    <!-- Subject -->
    <div class="space-y-2">
      <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
        {lang === 'es' ? 'Asunto *' : 'Subject *'}
      </label>
      <input
        type="text"
        id="subject"
        name="subject"
        required
        placeholder={lang === 'es' ? 'Ej. Cotización clúster Proxmox de 3 nodos' : 'e.g. 3-Node Proxmox Cluster Quote'}
        class="w-full bg-slate-950/80 border border-slate-800 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 transition-all outline-none"
      />
    </div>

    <!-- Message -->
    <div class="space-y-2">
      <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
        {lang === 'es' ? 'Mensaje o Detalles del Proyecto *' : 'Message or Project Requirements *'}
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        placeholder={lang === 'es' ? 'Describa sus necesidades de cómputo, almacenamiento, o si busca migrar desde otro proveedor...' : 'Describe your compute, storage, or migration requirements...'}
        class="w-full bg-slate-950/80 border border-slate-800 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 transition-all outline-none resize-y"
      ></textarea>
    </div>

    <!-- Cloudflare Turnstile Box -->
    <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="cf-turnstile" data-sitekey={sitekey} data-theme="dark"></div>
      
      <!-- Submit Button -->
      <button
        type="submit"
        id="submit-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-sm font-bold text-white bg-gradient-to-r from-sky-600 to-cyan-500 hover:from-sky-500 hover:to-cyan-400 rounded-xl shadow-lg shadow-sky-500/20 hover:shadow-sky-500/35 transition-all transform active:scale-95 disabled:opacity-50 cursor-pointer"
      >
        <span id="btn-text">{lang === 'es' ? 'Enviar Mensaje' : 'Send Message'}</span>
        <svg id="btn-spinner" class="hidden animate-spin ml-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </button>
    </div>

    <!-- Alerts / Messages -->
    <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-950/80 border border-emerald-800/80 text-emerald-300 text-sm flex items-start space-x-3">
      <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
      <div>
        <div class="font-bold">{lang === 'es' ? '¡Mensaje recibido con éxito!' : 'Message received successfully!'}</div>
        <div class="text-xs text-emerald-400/90 mt-0.5">
          {lang === 'es' ? 'Uno de nuestros ingenieros de soluciones se pondrá en contacto a la brevedad.' : 'One of our solutions engineers will be in touch shortly.'}
        </div>
      </div>
    </div>

    <div id="form-error" class="hidden p-4 rounded-xl bg-rose-950/80 border border-rose-800/80 text-rose-300 text-sm flex items-start space-x-3">
      <svg class="w-5 h-5 text-rose-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <div>
        <div class="font-bold">{lang === 'es' ? 'Error al enviar' : 'Submission failed'}</div>
        <div id="form-error-detail" class="text-xs text-rose-400/90 mt-0.5">
          {lang === 'es' ? 'Por favor verifique los campos o contáctenos directamente a contacto@kloudxp.com.' : 'Please verify all fields or email us directly at contacto@kloudxp.com.'}
        </div>
      </div>
    </div>
  </form>
</div>

<!-- Cloudflare Turnstile script -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.getElementById('kloudxp-contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');
  const errorDetail = document.getElementById('form-error-detail');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Reset alert boxes
    successBox?.classList.add('hidden');
    errorBox?.classList.add('hidden');

    // UI Loading state
    if (submitBtn) submitBtn.disabled = true;
    btnSpinner?.classList.remove('hidden');

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    // Basic honeypot check
    if (data._hp_company_field) {
      if (submitBtn) submitBtn.disabled = false;
      btnSpinner?.classList.add('hidden');
      return;
    }

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const json = await res.json().catch(() => ({}));

      if (res.ok) {
        successBox?.classList.remove('hidden');
        form.reset();
      } else {
        errorBox?.classList.remove('hidden');
        if (errorDetail && json.error) {
          errorDetail.textContent = json.error;
        }
      }
    } catch (err: any) {
      errorBox?.classList.remove('hidden');
      if (errorDetail) {
        errorDetail.textContent = err.message || 'Error de conexión con el servidor.';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      btnSpinner?.classList.add('hidden');
    }
  });
</script>
