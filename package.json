{
  "name": "kloudxp-website",
  "type": "module",
  "version": "1.0.0",
  "description": "Sitio web corporativo de KloudXP reconstruido con Astro y Cloudflare",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev dist/server/entry.mjs --assets dist/client",
    "deploy": "wrangler deploy dist/server/entry.mjs --assets dist/client"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^3.114.15"
  }
}
